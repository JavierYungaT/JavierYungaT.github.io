---
interface Props {
  id: string;
  title: string;
  /** Texto corto en monoespaciada encima del título. */
  eyebrow?: string;
  class?: string;
}

const { id, title, eyebrow, class: className } = Astro.props;
const headingId = `${id}-titulo`;
---

<section id={id} class:list={['section', className]} aria-labelledby={headingId}>
  <div class="container">
    <header class="section__header">
      {eyebrow && <p class="section__eyebrow">{eyebrow}</p>}
      <h2 id={headingId} class="section__title">{title}</h2>
      <slot name="intro" />
    </header>
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: var(--section-space) 0;
  }

  .section__header {
    display: grid;
    gap: 12px;
    margin-bottom: clamp(28px, 5vw, 44px);
    max-width: 680px;
  }

  .section__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent);
    letter-spacing: 0.02em;
  }

  .section__title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
  }
</style>
