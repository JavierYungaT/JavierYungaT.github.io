---
import BackgroundFx, { type FxEffect } from './BackgroundFx.astro';
import type { SectionHeading } from '@/types/content';

interface Props {
  id: string;
  heading: SectionHeading;
  /**
   * default: fondo del tema.
   * soft: degradado claro con franjas diagonales.
   * dark: azul marino (igual en ambos temas).
   */
  tone?: 'default' | 'soft' | 'dark';
  align?: 'center' | 'left';
  /** Fondo animado de la sección (opcional). */
  fx?: FxEffect;
}

const { id, heading, tone = 'default', align = 'center', fx } = Astro.props;
const headingId = `${id}-titulo`;
---

<section id={id} class:list={['section', `section--${tone}`]} aria-labelledby={headingId}>
  {fx && <BackgroundFx effect={fx} />}
  <div class="container">
    <header class:list={['section__header', `section__header--${align}`]} data-reveal>
      <p class="eyebrow">{heading.eyebrow}</p>
      <h2 id={headingId} class="section__title">{heading.title}</h2>
      <span class="divider" aria-hidden="true"></span>
      <slot name="intro" />
    </header>
    <slot />
  </div>
</section>

<style>
  .section {
    position: relative;
    padding-block: var(--section-space);
    overflow: hidden;
  }

  .section--soft {
    background: var(--bg-soft);
  }

  /* Franjas diagonales translúcidas de fondo. */
  .section--soft::before,
  .section--soft::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 52px;
    background: var(--band);
    transform: skewX(-12deg);
    pointer-events: none;
  }

  .section--soft::before {
    left: 9%;
  }

  .section--soft::after {
    right: 9%;
  }

  .section--dark {
    --fx-rgb: 110, 231, 183;
    --fx-alpha: 1;
    background: var(--gradient-ink);
    color: #ffffff;
  }

  .section--dark .eyebrow {
    color: rgba(255, 255, 255, 0.6);
  }

  .section__header {
    display: grid;
    gap: 16px;
    margin-bottom: clamp(40px, 6vw, 64px);
  }

  .section__header--center {
    justify-items: center;
    text-align: center;
    margin-inline: auto;
    max-width: 720px;
  }

  .section__header--left {
    justify-items: start;
    max-width: 640px;
  }

  .section__title {
    font-size: clamp(1.875rem, 4.4vw, 2.75rem);
  }

  .section__header :global(p:not(.eyebrow)) {
    color: var(--text-muted);
    font-size: 1.0625rem;
  }

  .section--dark .section__header :global(p:not(.eyebrow)) {
    color: rgba(255, 255, 255, 0.7);
  }
</style>
