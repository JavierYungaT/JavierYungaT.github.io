---
import { useI18n } from '@/i18n';

const { c, t, info } = useI18n(Astro.currentLocale);
const { site } = c;
---

<a class="logo" href={`${info.home}#inicio`} aria-label={`${site.name}, ${t.goHome}`}>
  <span class="logo__mark" aria-hidden="true">{site.logo.mark}</span>
  <span class="logo__text" aria-hidden="true">
    {site.logo.first}<span class="logo__accent">{site.logo.second}</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #ffffff;
    text-decoration: none;
  }

  .logo__mark {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 8px;
    background: var(--gradient);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -0.02em;
    box-shadow: 0 6px 18px -6px rgba(110, 231, 183, 0.6);
  }

  .logo__text {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .logo__accent {
    color: var(--brand-light);
  }
</style>
