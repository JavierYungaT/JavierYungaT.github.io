---
export type FxEffect = 'code' | 'pulses';

interface Props {
  /** code: palabras del stack cayendo. pulses: pistas de circuito con paquetes de datos. */
  effect: FxEffect;
}

const { effect } = Astro.props;
---

<canvas class="fx" data-fx={effect} aria-hidden="true"></canvas>

<script>
  // Fondos animados. El color sale de las variables CSS --fx-rgb y --fx-alpha de la sección,
  // así se adaptan al tema. Solo animan mientras son visibles y nunca con prefers-reduced-motion.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const TOKENS = ['const', '=>', '{ }', 'SELECT', 'JOIN', 'await', 'git push', 'JWT', '200 OK', 'SRI', 'XML', 'docker', 'Spring', 'NestJS', 'async', 'commit', 'INDEX', '</>', 'Flutter', 'REST', 'merge', 'AWS', 'Django', 'Redis'];
  const rand = (min: number, max: number) => min + Math.random() * (max - min);
  const pick = <T,>(list: readonly T[]): T => list[Math.floor(Math.random() * list.length)];

  interface Scene {
    w: number;
    h: number;
    px: number;
    py: number;
    rgb: string;
    alpha: number;
  }

  interface Effect {
    init(scene: Scene): void;
    draw(ctx: CanvasRenderingContext2D, scene: Scene, dt: number): void;
  }

  // ---------- Lluvia de código ----------
  function createCodeRain(): Effect {
    interface Column { x: number; y: number; speed: number; items: string[] }
    let columns: Column[] = [];
    const column = (x: number, y: number): Column => ({
      x,
      y,
      speed: rand(0.012, 0.03),
      items: Array.from({ length: Math.floor(rand(4, 9)) }, () => pick(TOKENS)),
    });

    return {
      init({ w, h }) {
        columns = [];
        const step = w < 600 ? 90 : 120;
        for (let x = 16; x < w; x += step) columns.push(column(x + rand(-20, 20), rand(60, h + 140)));
      },
      draw(ctx, { h, px, py, rgb, alpha }, dt) {
        ctx.font = '12px "JetBrains Mono", ui-monospace, monospace';
        for (const col of columns) {
          col.y += dt * col.speed;
          col.items.forEach((token, k) => {
            const y = col.y - k * 22;
            if (y < -20 || y > h + 20) return;
            const near = Math.abs(col.x - px) < 70 && Math.abs(y - py) < 70;
            const a = k === 0 || near ? 0.9 : Math.max(0.04, 0.32 - k * 0.035);
            ctx.fillStyle = `rgba(${rgb}, ${a * alpha})`;
            ctx.fillText(token, col.x, y);
          });
          if (col.y - col.items.length * 22 > h) Object.assign(col, column(col.x, rand(-120, -20)));
        }
      },
    };
  }

  // ---------- Pulsos de datos ----------
  function createPulses(): Effect {
    interface Path { pts: [number, number][]; lens: number[]; total: number; p: number; speed: number }
    let paths: Path[] = [];
    const GRID = 28;
    const TAIL = 36;

    const pointAt = (path: Path, distance: number): [number, number] => {
      const d = Math.max(0, Math.min(path.total, distance));
      let k = 1;
      while (k < path.lens.length - 1 && path.lens[k] < d) k++;
      const [x0, y0] = path.pts[k - 1];
      const [x1, y1] = path.pts[k];
      const f = (d - path.lens[k - 1]) / (path.lens[k] - path.lens[k - 1]);
      return [x0 + (x1 - x0) * f, y0 + (y1 - y0) * f];
    };

    return {
      init({ w, h }) {
        paths = [];
        const count = Math.round(Math.min(90, (w * h) / 9000));
        const dirs: [number, number][] = [[1, 0], [-1, 0], [0, 1], [0, -1]];
        for (let i = 0; i < count; i++) {
          let x = Math.round(rand(0, w) / GRID) * GRID;
          let y = Math.round(rand(0, h) / GRID) * GRID;
          let dir = pick(dirs);
          const pts: [number, number][] = [[x, y]];
          const steps = Math.floor(rand(5, 14));
          for (let k = 0; k < steps; k++) {
            if (Math.random() < 0.3) dir = dir[0] ? pick(dirs.slice(2)) : pick(dirs.slice(0, 2));
            x += dir[0] * GRID;
            y += dir[1] * GRID;
            pts.push([x, y]);
          }
          const lens = pts.map((_, k) => k * GRID);
          paths.push({ pts, lens, total: lens[lens.length - 1], p: rand(0, 1), speed: rand(0.00012, 0.00028) });
        }
      },
      draw(ctx, { px, py, rgb, alpha }, dt) {
        ctx.lineJoin = 'round';
        for (const path of paths) {
          ctx.lineWidth = 1;
          ctx.strokeStyle = `rgba(${rgb}, ${0.1 * alpha})`;
          ctx.beginPath();
          path.pts.forEach(([x, y], k) => (k ? ctx.lineTo(x, y) : ctx.moveTo(x, y)));
          ctx.stroke();
          const [ex, ey] = path.pts[path.pts.length - 1];
          ctx.fillStyle = `rgba(${rgb}, ${0.25 * alpha})`;
          ctx.fillRect(ex - 2, ey - 2, 4, 4);

          path.p += dt * path.speed;
          if (path.p > 1.3) path.p = 0;
          const head = path.p * path.total;
          if (head > path.total + TAIL) continue;

          const [hx, hy] = pointAt(path, head);
          const near = Math.hypot(hx - px, hy - py) < 100;
          ctx.lineWidth = 2;
          ctx.strokeStyle = `rgba(${rgb}, ${(near ? 1 : 0.75) * alpha})`;
          ctx.beginPath();
          const start = Math.max(0, head - TAIL);
          for (let d = start; d <= Math.min(head, path.total); d += 4) {
            const [x, y] = pointAt(path, d);
            d === start ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
          }
          ctx.stroke();
          if (head <= path.total) {
            ctx.fillStyle = `rgba(${rgb}, ${alpha})`;
            ctx.beginPath();
            ctx.arc(hx, hy, 2.2, 0, Math.PI * 2);
            ctx.fill();
          }
        }
      },
    };
  }

  const factories = { code: createCodeRain, pulses: createPulses };

  document.querySelectorAll<HTMLCanvasElement>('canvas[data-fx]').forEach((canvas) => {
    const ctx = canvas.getContext('2d');
    const host = canvas.parentElement;
    const factory = factories[canvas.dataset.fx as keyof typeof factories];
    if (!ctx || !host || !factory) return;

    const effect = factory();
    const scene: Scene = { w: 0, h: 0, px: -9999, py: -9999, rgb: '110, 231, 183', alpha: 1 };
    let running = false;
    let last = 0;

    function readColors(): void {
      const styles = getComputedStyle(canvas);
      scene.rgb = styles.getPropertyValue('--fx-rgb').trim() || scene.rgb;
      scene.alpha = Number(styles.getPropertyValue('--fx-alpha')) || 1;
    }

    function setup(): void {
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      scene.w = canvas.clientWidth;
      scene.h = canvas.clientHeight;
      canvas.width = scene.w * ratio;
      canvas.height = scene.h * ratio;
      ctx!.setTransform(ratio, 0, 0, ratio, 0, 0);
      readColors();
      effect.init(scene);
      render(16);
    }

    function render(dt: number): void {
      ctx!.clearRect(0, 0, scene.w, scene.h);
      effect.draw(ctx!, scene, dt);
    }

    function tick(now: number): void {
      if (!running) return;
      render(Math.min(now - last, 50));
      last = now;
      requestAnimationFrame(tick);
    }

    new IntersectionObserver(([entry]) => {
      const shouldRun = entry.isIntersecting && !reduceMotion;
      if (shouldRun && !running) {
        running = true;
        last = performance.now();
        requestAnimationFrame(tick);
      } else if (!shouldRun) {
        running = false;
      }
    }).observe(canvas);

    host.addEventListener('pointermove', (event) => {
      const rect = canvas.getBoundingClientRect();
      scene.px = event.clientX - rect.left;
      scene.py = event.clientY - rect.top;
    });
    host.addEventListener('pointerleave', () => {
      scene.px = -9999;
      scene.py = -9999;
    });

    // Recolorea al cambiar de tema (botón o sistema).
    const recolor = () => {
      readColors();
      if (!running) render(0);
    };
    new MutationObserver(recolor).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', recolor);

    let resizeTimer: number | undefined;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(setup, 150);
    });

    setup();
    // Con movimiento reducido se dibuja un cuadro quieto ya "avanzado".
    if (reduceMotion) for (let i = 0; i < 60; i++) render(16);
  });
</script>

<style>
  .fx {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
