---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { languages, localeInfo, useI18n, type Lang } from '@/i18n';

interface Props {
  /** URL equivalente de esta página en cada idioma (para el selector ES/EN). */
  alternates?: Partial<Record<Lang, string>>;
}

const { c, t, lang } = useI18n(Astro.currentLocale);
const { navigation } = c;
const alternates: Record<Lang, string> = {
  es: Astro.props.alternates?.es ?? localeInfo.es.home,
  en: Astro.props.alternates?.en ?? localeInfo.en.home,
};
const langCodes = Object.keys(languages) as Lang[];
---

<header class="header" id="site-header">
  <div class="container header__inner">
    <Logo />

    <nav class="header__nav" aria-label={t.mainNav}>
      <ul class="header__links" id="menu-principal">
        {
          navigation.map((link) => (
            <li>
              <a href={link.href} data-nav>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions">
      <nav class="lang-switch" aria-label={t.language}>
        {
          langCodes.map((code) =>
            code === lang ? (
              <span class="lang-switch__item is-current" aria-current="true" lang={code}>
                {code.toUpperCase()}
              </span>
            ) : (
              <a
                class="lang-switch__item"
                href={alternates[code]}
                hreflang={code}
                lang={code}
                aria-label={`${t.switchTo} ${languages[code]}`}
              >
                {code.toUpperCase()}
              </a>
            ),
          )
        }
      </nav>
      <ThemeToggle />
      <button
        class="header__menu-button"
        type="button"
        aria-expanded="false"
        aria-controls="menu-principal"
        aria-label={t.openMenu}
        data-open-label={t.openMenu}
        data-close-label={t.closeMenu}
      >
        <Icon name="menu" size={20} class="header__menu-open" />
        <Icon name="close" size={20} class="header__menu-close" />
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const menuButton = header?.querySelector<HTMLButtonElement>('.header__menu-button');
  const links = header?.querySelectorAll<HTMLAnchorElement>('[data-nav]') ?? [];

  function setMenu(open: boolean): void {
    header?.classList.toggle('is-open', open);
    menuButton?.setAttribute('aria-expanded', String(open));
    menuButton?.setAttribute('aria-label', (open ? menuButton.dataset.closeLabel : menuButton.dataset.openLabel) ?? '');
    syncScrolled();
  }

  function syncScrolled(): void {
    header?.classList.toggle('is-scrolled', window.scrollY > 24 || header.classList.contains('is-open'));
  }

  menuButton?.addEventListener('click', () => setMenu(!header?.classList.contains('is-open')));
  links.forEach((link) => link.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && header?.classList.contains('is-open')) {
      setMenu(false);
      menuButton?.focus();
    }
  });
  window.addEventListener('scroll', syncScrolled, { passive: true });
  syncScrolled();

  // Resalta el enlace de la sección visible.
  const sectionObserver = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        links.forEach((link) =>
          link.toggleAttribute('data-active', link.hash === `#${entry.target.id}`),
        );
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  links.forEach((link) => {
    const target = link.hash ? document.querySelector(link.hash) : null;
    if (target) sectionObserver.observe(target);
  });
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.4s ease,
      border-color 0.4s ease,
      backdrop-filter 0.4s ease;
  }

  .header.is-scrolled {
    background: rgba(6, 18, 14, 0.86);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: var(--header-h);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .header__links {
    list-style: none;
  }

  /* Selector de idioma ES / EN */
  .lang-switch {
    display: inline-flex;
    padding: 3px;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.22);
  }

  .lang-switch__item {
    display: inline-grid;
    place-items: center;
    min-width: 34px;
    height: 34px;
    padding: 0 6px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }

  a.lang-switch__item:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
  }

  .lang-switch__item.is-current {
    background: var(--gradient);
    color: #ffffff;
  }

  .header__links a {
    position: relative;
    display: inline-block;
    padding: 8px 0;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .header__links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 2px;
    background: var(--gradient);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease-out);
  }

  .header__links a:hover,
  .header__links a[data-active] {
    color: #ffffff;
  }

  .header__links a:hover::after,
  .header__links a[data-active]::after {
    transform: scaleX(1);
  }

  .header__menu-button {
    display: inline-grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: transparent;
    color: #ffffff;
    cursor: pointer;
  }

  .header__menu-button :global(.header__menu-close),
  .header.is-open .header__menu-button :global(.header__menu-open) {
    display: none;
  }

  .header.is-open .header__menu-button :global(.header__menu-close) {
    display: block;
  }

  /* Pantallas angostas: controles más compactos para que entren logo, idioma, tema y menú. */
  @media (max-width: 420px) {
    .header__inner {
      gap: 10px;
    }

    .header__actions {
      gap: 6px;
    }

    .header :global(.logo__mark) {
      width: 32px;
      height: 32px;
      font-size: 0.875rem;
    }

    .header :global(.logo) {
      gap: 8px;
    }

    .header :global(.logo__text) {
      font-size: 1.0625rem;
    }

    .lang-switch__item {
      min-width: 28px;
      height: 30px;
      padding: 0 4px;
    }

    .header__menu-button,
    .header :global(.theme-toggle) {
      width: 38px;
      height: 38px;
    }
  }

  /* Móvil: menú desplegable bajo la barra. */
  @media (max-width: 799px) {
    .header__nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--ink-950);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition:
        opacity 0.3s ease,
        transform 0.3s var(--ease-out),
        visibility 0.3s;
    }

    .header.is-open .header__nav {
      visibility: visible;
      opacity: 1;
      transform: none;
    }

    .header__links {
      display: grid;
      padding: 8px var(--gutter) 20px;
    }

    .header__links a {
      display: block;
      padding: 14px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .header__links a::after {
      display: none;
    }
  }

  @media (min-width: 800px) {
    .header__menu-button {
      display: none;
    }

    .header__nav {
      margin-left: auto;
    }

    .header__links {
      display: flex;
      gap: 32px;
    }
  }
</style>
