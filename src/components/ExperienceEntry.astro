---
import TagList from './TagList.astro';
import { commitHash } from '@/lib/commit-hash';
import type { Experience } from '@/types/content';

interface Props {
  entry: Experience;
}

const { entry } = Astro.props;
const hash = commitHash(`${entry.company}:${entry.role}`);
---

<li class:list={['commit', { 'commit--current': entry.current }]}>
  <span class="commit__node" aria-hidden="true"></span>
  <article class="commit__body">
    <p class="commit__meta">
      <code class="commit__hash" aria-hidden="true">{hash}</code>
      {entry.ref && <span class="commit__ref">{entry.ref}</span>}
      <span class="commit__period">{entry.period}</span>
      {entry.current && <span class="sr-only">(actual)</span>}
    </p>
    <h3 class="commit__title">
      {entry.role}{' '}
      <span class="commit__company">· {entry.company}</span>
    </h3>
    <ul class="commit__highlights">
      {entry.highlights.map((highlight) => <li>{highlight}</li>)}
    </ul>
    <TagList tags={entry.tags} label={`Tecnologías en ${entry.company}`} />
  </article>
</li>

<style>
  .commit {
    --node-size: 16px;
    position: relative;
    padding-left: 36px;
    padding-bottom: 40px;
  }

  .commit:last-child {
    padding-bottom: 0;
  }

  .commit__node {
    position: absolute;
    left: 0;
    top: 4px;
    width: var(--node-size);
    height: var(--node-size);
    border-radius: 50%;
    border: 2px solid var(--accent);
    background: var(--bg);
  }

  .commit--current .commit__node {
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  .commit__body {
    display: grid;
    gap: 10px;
  }

  .commit__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--text-muted);
  }

  .commit__hash {
    color: var(--accent);
  }

  .commit__ref {
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid var(--accent);
    color: var(--accent);
    font-size: 0.75rem;
  }

  .commit__title {
    font-size: clamp(1.1875rem, 2.4vw, 1.375rem);
    font-weight: 600;
  }

  .commit__company {
    font-weight: 500;
    color: var(--text-muted);
  }

  .commit__highlights {
    display: grid;
    gap: 6px;
    padding-left: 18px;
    color: var(--text-muted);
    max-width: 72ch;
  }

  .commit__highlights li::marker {
    color: var(--border);
  }

  .commit__body :global(.tags) {
    margin-top: 4px;
  }
</style>
