---
import TagList from './TagList.astro';
import { commitHash } from '@/lib/commit-hash';
import type { Experience } from '@/types/content';

interface Props {
  entry: Experience;
  /** Retraso de la animación de aparición en ms. */
  delay?: number;
}

const { entry, delay = 0 } = Astro.props;
const hash = commitHash(`${entry.company}:${entry.role}`);
---

<li class:list={['commit', { 'commit--current': entry.current }]} data-reveal style={`--d: ${delay}ms`}>
  <span class="commit__node" aria-hidden="true"><i></i></span>
  <article class="commit__card card card--hover-bar">
    <p class="commit__meta">
      <code class="commit__hash" aria-hidden="true">{hash}</code>
      {entry.ref && <span class="commit__ref">{entry.ref}</span>}
      <span class="commit__period">{entry.period}</span>
      {entry.current && <span class="sr-only">(actual)</span>}
    </p>
    <h3 class="commit__title">
      {entry.role}{' '}
      <span class="commit__company">· {entry.company}</span>
    </h3>
    <ul class="commit__highlights">
      {entry.highlights.map((highlight) => <li>{highlight}</li>)}
    </ul>
    <TagList tags={entry.tags} label={`Tecnologías en ${entry.company}`} />
  </article>
</li>

<style>
  .commit {
    position: relative;
    padding-left: 44px;
    padding-bottom: 24px;
  }

  .commit:last-child {
    padding-bottom: 0;
  }

  .commit__node {
    position: absolute;
    left: 0;
    top: 26px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 2px solid var(--blue);
    background: var(--surface);
  }

  .commit--current .commit__node {
    border-color: transparent;
    background: var(--gradient);
    box-shadow: 0 0 0 5px rgba(22, 200, 245, 0.18);
  }

  .commit--current .commit__node i {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--cyan);
    animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  .commit__card {
    display: grid;
    gap: 12px;
    padding: clamp(20px, 3vw, 28px);
  }

  .commit__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--text-muted);
  }

  .commit__hash {
    color: var(--blue);
    font-weight: 500;
  }

  .commit__ref {
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--gradient);
    color: #ffffff;
    font-size: 0.75rem;
  }

  .commit__title {
    font-size: clamp(1.1875rem, 2.4vw, 1.375rem);
  }

  .commit__company {
    color: var(--blue);
    font-weight: 500;
  }

  .commit__highlights {
    list-style: none;
    display: grid;
    gap: 8px;
    color: var(--text-muted);
  }

  .commit__highlights li {
    position: relative;
    padding-left: 20px;
  }

  .commit__highlights li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.72em;
    width: 8px;
    height: 2px;
    border-radius: 2px;
    background: var(--gradient);
  }

  .commit__card :global(.tags) {
    margin-top: 6px;
  }

  :global(:root[data-theme='dark']) .commit__company,
  :global(:root[data-theme='dark']) .commit__hash {
    color: var(--accent);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .commit__company,
    :global(:root:not([data-theme='light'])) .commit__hash {
      color: var(--accent);
    }
  }
</style>
