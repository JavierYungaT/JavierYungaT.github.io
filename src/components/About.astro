---
import Button from './Button.astro';
import CodeWindow from './CodeWindow.astro';
import Icon from './Icon.astro';
import Section from './Section.astro';
import { about } from '@/data/profile';
import { sections } from '@/data/site';

// Código decorativo que se escribe solo (k: palabra clave, s: texto, f: función, n: valor, c: comentario).
const codeSample = [
  `<span class="k">import</span> { Ingeniero } <span class="k">from</span> <span class="s">'javier-yunga'</span>;`,
  ``,
  `<span class="k">const</span> javier = <span class="k">new</span> <span class="f">Ingeniero</span>({`,
  `  experiencia: <span class="s">'4+ años'</span>,`,
  `  enfoque: [<span class="s">'web'</span>, <span class="s">'móvil'</span>, <span class="s">'backend'</span>],`,
  `  stack: [<span class="s">'Spring Boot'</span>, <span class="s">'NestJS'</span>, <span class="s">'Django'</span>],`,
  `  disponible: <span class="n">true</span>,`,
  `});`,
  ``,
  `javier.<span class="f">construir</span>(); <span class="c">// software que se usa a diario</span>`,
].join('\n');
---

<Section id="sobre-mi" heading={sections.about} align="left">
  <div class="about">
    <div class="about__text" data-reveal>
      {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}

      <ul class="about__chips" aria-label="Cómo trabajo">
        {
          about.principles.map((principle) => (
            <li>
              <Icon name={principle.icon} size={20} />
              {principle.label}
            </li>
          ))
        }
      </ul>

      <Button href="#contacto" variant="outline" icon="arrowRight">Hablemos</Button>
    </div>

    <div class="about__visual" aria-hidden="true" data-reveal style="--d: 150ms">
      <div class="about__float">
        <CodeWindow filename="javier.ts" typewriter><Fragment set:html={codeSample} /></CodeWindow>
      </div>
      <ul class="about__highlights">
        {
          about.highlights.map((item) => (
            <li>
              <small>{item.detail}</small>
              {item.label}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Section>

<style>
  .about {
    display: grid;
    gap: 64px;
  }

  .about__text {
    display: grid;
    gap: 20px;
    justify-items: start;
    color: var(--text-muted);
    font-size: 1.0625rem;
  }

  .about__chips {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 12px;
    width: 100%;
    margin: 8px 0 12px;
  }

  .about__chips li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 13px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text);
    font-size: 0.9375rem;
    font-weight: 500;
    transition:
      border-color 0.3s ease,
      transform 0.3s var(--ease-out);
  }

  .about__chips li:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .about__chips :global(.icon) {
    color: var(--accent);
  }

  .about__visual {
    position: relative;
    max-width: 520px;
    width: 100%;
    justify-self: center;
    padding: 34px 0 40px;
  }

  .about__float {
    animation: float 7s ease-in-out infinite;
  }

  .about__highlights {
    list-style: none;
  }

  .about__highlights li {
    position: absolute;
    display: grid;
    padding: 12px 18px;
    border-radius: 8px;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    animation: float 6s ease-in-out infinite;
  }

  .about__highlights small {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .about__highlights li:first-child {
    top: 0;
    right: 8px;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    box-shadow: var(--shadow);
  }

  .about__highlights li:last-child {
    bottom: 0;
    left: 8px;
    background: var(--gradient);
    color: #ffffff;
    box-shadow: var(--shadow-glow);
    animation-delay: -3s;
  }

  @media (min-width: 960px) {
    .about {
      grid-template-columns: 1.15fr 0.85fr;
      align-items: center;
      gap: 80px;
    }

    .about__highlights li:first-child {
      right: -20px;
    }

    .about__highlights li:last-child {
      left: -28px;
    }
  }
</style>
