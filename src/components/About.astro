---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Button from './Button.astro';
import Icon from './Icon.astro';
import Section from './Section.astro';
import { about, hero } from '@/data/profile';
import { sections, site } from '@/data/site';

// Se resuelve en el build: si la foto no existe en public/, se muestra el monograma.
const hasPhoto = existsSync(join(process.cwd(), 'public', hero.photo));
---

<Section id="sobre-mi" heading={sections.about} align="left">
  <div class="about">
    <div class="about__text" data-reveal>
      {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}

      <ul class="about__chips" aria-label="Cómo trabajo">
        {
          about.principles.map((principle) => (
            <li>
              <Icon name={principle.icon} size={20} />
              {principle.label}
            </li>
          ))
        }
      </ul>

      <Button href="#contacto" variant="outline" icon="arrowRight">Hablemos</Button>
    </div>

    <div class="about__visual" data-reveal style="--d: 150ms">
      <div class="about__portrait">
        {
          hasPhoto ? (
            <span class="about__photo">
              <img src={hero.photo} alt={`Foto de ${site.name}`} width="500" height="500" loading="lazy" />
            </span>
          ) : (
            <span class="about__monogram" aria-hidden="true">
              {hero.monogram}
            </span>
          )
        }
      </div>
      <ul class="about__highlights">
        {
          about.highlights.map((item) => (
            <li>
              <small>{item.detail}</small>
              {item.label}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Section>

<style>
  .about {
    display: grid;
    gap: 64px;
  }

  .about__text {
    display: grid;
    gap: 20px;
    justify-items: start;
    color: var(--text-muted);
    font-size: 1.0625rem;
  }

  .about__chips {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 12px;
    width: 100%;
    margin: 8px 0 12px;
  }

  .about__chips li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 13px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text);
    font-size: 0.9375rem;
    font-weight: 500;
    transition:
      border-color 0.3s ease,
      transform 0.3s var(--ease-out);
  }

  .about__chips li:hover {
    border-color: var(--blue);
    transform: translateY(-2px);
  }

  .about__chips :global(.icon) {
    color: var(--blue);
  }

  .about__visual {
    position: relative;
    max-width: 420px;
    width: 100%;
    justify-self: center;
    padding: 0 12px 28px;
  }

  .about__portrait {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 14px;
    background: var(--gradient-navy);
    box-shadow: var(--shadow);
  }

  .about__portrait::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 32px 32px;
    pointer-events: none;
  }

  /* Foto circular con anillo de degradado, centrada sobre la tarjeta azul marino. */
  .about__photo {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
  }

  .about__photo img {
    width: 78%;
    aspect-ratio: 1;
    padding: 5px;
    border-radius: 50%;
    background: var(--gradient);
    object-fit: cover;
    box-shadow: 0 30px 60px -20px rgba(10, 108, 240, 0.6);
  }

  .about__monogram {
    display: grid;
    place-items: center;
    height: 100%;
    font-family: var(--font-display);
    font-size: clamp(6rem, 22vw, 9rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    background: var(--gradient-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .about__highlights {
    list-style: none;
  }

  .about__highlights li {
    position: absolute;
    display: grid;
    padding: 12px 18px;
    border-radius: 8px;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    animation: float 6s ease-in-out infinite;
  }

  .about__highlights small {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .about__highlights li:first-child {
    top: 32px;
    left: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    box-shadow: var(--shadow);
  }

  .about__highlights li:last-child {
    bottom: 0;
    right: 0;
    background: var(--gradient);
    color: #ffffff;
    box-shadow: var(--shadow-glow);
    animation-delay: -3s;
  }

  @media (min-width: 960px) {
    .about {
      grid-template-columns: 1.15fr 0.85fr;
      align-items: center;
      gap: 80px;
    }

    .about__highlights li:first-child {
      left: -36px;
    }

    .about__highlights li:last-child {
      right: -24px;
    }
  }
</style>
