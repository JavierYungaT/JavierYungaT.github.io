---
import Section from './Section.astro';
import { about } from '@/data/profile';
---

<Section id="sobre-mi" title="Sobre mí">
  <div class="about">
    <div class="about__text">
      {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <aside class="about__principles card" aria-labelledby="principios-titulo">
      <h3 id="principios-titulo" class="about__principles-title">Cómo trabajo</h3>
      <ul class="about__chips">
        {about.principles.map((principle) => <li>{principle}</li>)}
      </ul>
    </aside>
  </div>
</Section>

<style>
  .about {
    display: grid;
    gap: 28px;
  }

  .about__text {
    display: grid;
    gap: 16px;
    font-size: 1.0625rem;
    max-width: 66ch;
  }

  .about__principles {
    padding: 24px;
    align-self: start;
  }

  .about__principles-title {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--text-muted);
    margin-bottom: 14px;
  }

  .about__chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .about__chips li {
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.875rem;
    font-weight: 500;
  }

  @media (min-width: 880px) {
    .about {
      grid-template-columns: 1fr 340px;
      gap: 56px;
    }
  }
</style>
