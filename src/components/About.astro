---
import Button from './Button.astro';
import CodeWindow from './CodeWindow.astro';
import Icon from './Icon.astro';
import Section from './Section.astro';
import { useI18n } from '@/i18n';

const { c, t } = useI18n(Astro.currentLocale);
const { about, sections } = c;
---

<Section id="sobre-mi" heading={sections.about} align="left">
  <div class="about">
    <div class="about__text" data-reveal>
      {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}

      <ul class="soft-skills" aria-label={t.softSkills}>
        {
          about.softSkills.map((skill) => (
            <li class="soft-skill">
              <span class="soft-skill__icon">
                <Icon name={skill.icon} size={20} />
              </span>
              <span class="soft-skill__text">
                <strong>{skill.title}</strong>
                <span>{skill.proof}</span>
              </span>
            </li>
          ))
        }
      </ul>

      <Button href="#contacto" variant="outline" icon="arrowRight">{t.letsTalk}</Button>
    </div>

    <div class="about__visual" aria-hidden="true" data-reveal style="--d: 150ms">
      <div class="about__float">
        <CodeWindow filename="javier.ts" typewriter><Fragment set:html={about.code} /></CodeWindow>
      </div>
      <ul class="about__highlights">
        {
          about.highlights.map((item) => (
            <li>
              <small>{item.detail}</small>
              {item.label}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Section>

<style>
  .about {
    display: grid;
    gap: 64px;
  }

  .about__text {
    display: grid;
    gap: 20px;
    justify-items: start;
    color: var(--text-muted);
    font-size: 1.0625rem;
  }

  .soft-skills {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: 12px;
    width: 100%;
    margin: 8px 0 12px;
  }

  .soft-skill {
    display: flex;
    gap: 14px;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    transition:
      border-color 0.3s ease,
      transform 0.3s var(--ease-out);
  }

  .soft-skill:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .soft-skill__icon {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 8px;
    background: var(--surface-muted);
    color: var(--accent);
  }

  .soft-skill__text {
    display: grid;
    align-content: start;
    gap: 2px;
    min-width: 0;
  }

  .soft-skill__text strong {
    color: var(--text);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .soft-skill__text span {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--text-muted);
  }

  .about__visual {
    position: relative;
    max-width: 520px;
    width: 100%;
    justify-self: center;
    padding: 34px 0 40px;
  }

  .about__float {
    animation: float 7s ease-in-out infinite;
  }

  .about__highlights {
    list-style: none;
  }

  .about__highlights li {
    position: absolute;
    display: grid;
    padding: 12px 18px;
    border-radius: 8px;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    animation: float 6s ease-in-out infinite;
  }

  .about__highlights small {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .about__highlights li:first-child {
    top: 0;
    right: 8px;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    box-shadow: var(--shadow);
  }

  .about__highlights li:last-child {
    bottom: 0;
    left: 8px;
    background: var(--gradient);
    color: #ffffff;
    box-shadow: var(--shadow-glow);
    animation-delay: -3s;
  }

  @media (min-width: 960px) {
    .about {
      grid-template-columns: 1.15fr 0.85fr;
      align-items: center;
      gap: 80px;
    }

    .about__highlights li:first-child {
      right: -20px;
    }

    .about__highlights li:last-child {
      left: -28px;
    }
  }
</style>
