---
import { render, type CollectionEntry } from 'astro:content';
import BackgroundFx from './BackgroundFx.astro';
import Button from './Button.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import Icon from './Icon.astro';
import TagList from './TagList.astro';
import { useI18n, type Lang } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';

interface Props {
  caso: CollectionEntry<'casos'>;
  /** URL de este mismo caso en cada idioma. */
  alternates: Partial<Record<Lang, string>>;
}

const { caso, alternates } = Astro.props;
const { c, t, info } = useI18n(Astro.currentLocale);
const { contact, site } = c;
const { Content } = await render(caso);
const { title, summary, role, period, context, stack, results } = caso.data;
---

<BaseLayout title={`${title} · ${t.caseStudy} · ${site.name}`} description={summary} alternates={alternates}>
  <Header alternates={alternates} />
  <main id="contenido">
    <section class="case-hero" aria-labelledby="caso-titulo">
      <div class="case-hero__backdrop" aria-hidden="true"></div>
      <BackgroundFx effect="code" />
      <div class="container case-hero__inner" data-reveal>
        <a class="case-hero__back" href={`${info.home}#proyectos`}>
          <Icon name="arrowRight" size={16} class="case-hero__back-icon" />
          {t.backToProjects}
        </a>
        <p class="eyebrow case-hero__eyebrow">{t.caseStudy}</p>
        <h1 id="caso-titulo" class="case-hero__title">{title}</h1>
        <p class="case-hero__summary">{summary}</p>
        <dl class="case-hero__meta">
          <div><dt>{t.role}</dt><dd>{role}</dd></div>
          <div><dt>{t.period}</dt><dd>{period}</dd></div>
          <div><dt>{t.context}</dt><dd>{context}</dd></div>
        </dl>
      </div>
    </section>

    <div class="container case-results-wrap">
      <dl class="case-results card">
        {
          results.map((result, index) => (
            <div data-reveal style={`--d: ${index * 120}ms`}>
              <dd>{result.value}</dd>
              <dt>{result.label}</dt>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="container case-body">
      <article class="prose" data-reveal>
        <Content />
      </article>

      <aside class="case-aside" data-reveal style="--d: 150ms">
        <div class="case-aside__box card">
          <p class="case-aside__label">{t.stack}</p>
          <TagList tags={stack} label={t.projectTechnologies} />
        </div>
        <div class="case-aside__box card">
          <p class="case-aside__label">{t.wantDetails}</p>
          <p class="case-aside__text">{t.detailsInInterview}</p>
          <Button href={`mailto:${contact.email}`} icon="mail">{t.writeMe}</Button>
        </div>
      </aside>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .case-hero {
    --fx-rgb: 110, 231, 183;
    --fx-alpha: 1;
    position: relative;
    padding: calc(var(--header-h) + 48px) 0 140px;
    color: #ffffff;
    isolation: isolate;
  }

  .case-hero__backdrop,
  .case-hero > :global(.fx) {
    position: absolute;
    inset: 0;
    z-index: -1;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 48px), 0 100%);
  }

  .case-hero__backdrop {
    background: var(--gradient-ink);
  }

  .case-hero > :global(.fx) {
    -webkit-mask-image: linear-gradient(90deg, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.3) 50%, #000 85%);
    mask-image: linear-gradient(90deg, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.3) 50%, #000 85%);
  }

  .case-hero__inner {
    display: grid;
    gap: 18px;
    justify-items: start;
  }

  .case-hero__back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.875rem;
    text-decoration: none;
  }

  .case-hero__back:hover {
    color: var(--brand-light);
  }

  .case-hero__back :global(.case-hero__back-icon) {
    transform: rotate(180deg);
  }

  .case-hero__eyebrow {
    color: var(--brand-light);
    margin-top: 12px;
  }

  .case-hero__title {
    font-size: clamp(2rem, 5.5vw, 3.5rem);
    letter-spacing: -0.035em;
    max-width: 20ch;
  }

  .case-hero__summary {
    max-width: 62ch;
    font-size: clamp(1rem, 1.6vw, 1.1875rem);
    color: rgba(255, 255, 255, 0.74);
  }

  .case-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 40px;
    margin: 12px 0 0;
  }

  .case-hero__meta dt {
    font-size: 0.75rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }

  .case-hero__meta dd {
    margin: 4px 0 0;
    font-weight: 500;
  }

  /* Resultados */
  .case-results-wrap {
    margin-top: -88px;
  }

  .case-results {
    display: grid;
    margin: 0;
    box-shadow: var(--shadow);
  }

  .case-results > div {
    display: grid;
    gap: 6px;
    padding: 24px 28px;
  }

  .case-results > div + div {
    border-top: 1px solid var(--border);
  }

  .case-results dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--accent);
  }

  .case-results dt {
    color: var(--text-muted);
  }

  @media (min-width: 720px) {
    .case-results {
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    }

    .case-results > div + div {
      border-top: 0;
      border-left: 1px solid var(--border);
    }
  }

  /* Cuerpo */
  .case-body {
    display: grid;
    gap: 40px;
    padding-block: clamp(56px, 8vw, 96px) var(--section-space);
  }

  .case-aside {
    display: grid;
    gap: 16px;
    align-content: start;
  }

  .case-aside__box {
    display: grid;
    gap: 14px;
    justify-items: start;
    padding: 24px;
  }

  .case-aside__label {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .case-aside__text {
    color: var(--text-muted);
  }

  @media (min-width: 1024px) {
    .case-body {
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: 64px;
    }

    .case-aside {
      position: sticky;
      top: calc(var(--header-h) + 24px);
    }
  }

  /* Texto del Markdown */
  .prose {
    min-width: 0;
    max-width: 72ch;
    color: var(--text-muted);
    font-size: 1.0625rem;
  }

  .prose :global(h2) {
    margin: 48px 0 16px;
    font-size: clamp(1.5rem, 3vw, 1.875rem);
    color: var(--text);
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(p),
  .prose :global(ol),
  .prose :global(ul) {
    margin: 0 0 18px;
  }

  .prose :global(strong) {
    color: var(--text);
  }

  .prose :global(ol) {
    list-style: none;
    counter-reset: paso;
    display: grid;
    gap: 12px;
  }

  .prose :global(ol li) {
    counter-increment: paso;
    position: relative;
    padding-left: 48px;
  }

  .prose :global(ol li::before) {
    content: counter(paso, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--accent);
  }

  .prose :global(:not(pre) > code) {
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--surface-muted);
    color: var(--text);
    font-size: 0.875em;
  }

  .prose :global(pre) {
    margin: 0 0 24px;
    padding: 22px;
    overflow-x: auto;
    border-radius: var(--radius);
    border: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .prose :global(pre[data-language='text']) {
    line-height: 1.25;
  }

  .prose :global(blockquote) {
    margin: 32px 0 0;
    padding: 16px 20px;
    border-left: 3px solid var(--brand);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: var(--surface-muted);
  }

  .prose :global(blockquote p) {
    margin: 0;
    font-size: 0.9375rem;
  }
</style>
