---
import Icon from './Icon.astro';
import Modal from './Modal.astro';
import ModalTrigger from './ModalTrigger.astro';
import Section from './Section.astro';
import { useI18n } from '@/i18n';

const { c, t } = useI18n(Astro.currentLocale);
const { certifications, certificationsPreviewCount, degree, sections } = c;
const visibleCertifications = certifications.slice(0, certificationsPreviewCount);
const hasMore = certifications.length > certificationsPreviewCount;
---

<Section id="formacion" heading={sections.education} align="left">
  <div class="education">
    <article class="degree" data-reveal>
      <Icon name="graduation" size={40} class="degree__icon" />
      <p class="degree__period">{degree.period}</p>
      <h3 class="degree__title">{degree.title}</h3>
      <p class="degree__institution">{degree.institution}</p>
      {
        degree.note && (
          <p class="degree__note">
            <Icon name="badge" size={18} />
            {degree.note}
          </p>
        )
      }
    </article>

    <div class="certs" data-reveal style="--d: 150ms">
      <h3 class="certs__title">{t.certifications}</h3>
      <ol class="certs__list">
        {
          visibleCertifications.map((cert, index) => (
            <li class="certs__item">
              <span class="certs__index" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="certs__body">
                <span class="certs__name">{cert.name}</span>
                <span class="certs__issuer">{cert.issuer}</span>
              </span>
              <time datetime={cert.isoDate}>{cert.date}</time>
            </li>
          ))
        }
      </ol>
      {
        hasMore && (
          <ModalTrigger target="todas-certificaciones" icon="badge" tone="light" align="start">
            {t.seeAllCertifications} ({certifications.length})
          </ModalTrigger>
        )
      }
    </div>
  </div>

  {
    hasMore && (
      <Modal id="todas-certificaciones" title={t.certifications} closeLabel={t.close}>
        <ol class="certs__list certs__list--dark">
          {
            certifications.map((cert, index) => (
              <li class="certs__item">
                <span class="certs__index" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span class="certs__body">
                  <span class="certs__name">{cert.name}</span>
                  <span class="certs__issuer">{cert.issuer}</span>
                </span>
                <time datetime={cert.isoDate}>{cert.date}</time>
              </li>
            ))
          }
        </ol>
      </Modal>
    )
  }
</Section>

<style>
  .education {
    display: grid;
    gap: 48px;
  }

  .degree {
    position: relative;
    display: grid;
    gap: 10px;
    align-content: start;
    padding: clamp(28px, 4vw, 40px);
    border-radius: var(--radius);
    background: var(--gradient-ink);
    color: #ffffff;
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .degree::after {
    content: '';
    position: absolute;
    right: -30%;
    top: -40%;
    width: 80%;
    height: 100%;
    background: radial-gradient(closest-side, rgba(110, 231, 183, 0.25), transparent);
    pointer-events: none;
  }

  .degree :global(.degree__icon) {
    color: var(--brand-light);
    margin-bottom: 12px;
  }

  .degree__period {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .degree__title {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .degree__institution {
    color: var(--brand-light);
    font-weight: 500;
  }

  .degree__note {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 16px;
    padding-top: 18px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.875rem;
  }

  .certs__title {
    font-size: 1.25rem;
    margin-bottom: 8px;
  }

  .certs__list {
    list-style: none;
  }

  .certs__item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: 16px;
    padding-block: 15px;
    border-bottom: 1px solid var(--border);
    transition: padding-left 0.3s var(--ease-out);
  }

  .certs__item:hover {
    padding-left: 6px;
  }

  .certs__index {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--accent);
  }

  .certs__body {
    display: grid;
    gap: 2px;
  }

  .certs__name {
    font-weight: 500;
    line-height: 1.45;
  }

  .certs__issuer {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .certs__item time {
    font-size: 0.8125rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .certs__list--dark .certs__item {
    border-bottom-color: rgba(255, 255, 255, 0.1);
  }

  .certs__list--dark .certs__index {
    color: var(--brand-light);
  }

  .certs__list--dark .certs__name {
    color: #ffffff;
  }

  .certs__list--dark .certs__issuer,
  .certs__list--dark time {
    color: rgba(255, 255, 255, 0.65);
  }

  @media (min-width: 960px) {
    .education {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      align-items: start;
      gap: 64px;
    }

    .degree {
      position: sticky;
      top: calc(var(--header-h) + 24px);
    }
  }
</style>
