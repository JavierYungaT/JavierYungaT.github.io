---
import Section from './Section.astro';
import { certifications, degree } from '@/data/education';
---

<Section id="formacion" title="Formación">
  <div class="education">
    <article class="degree card">
      <p class="degree__period">{degree.period}</p>
      <h3 class="degree__title">{degree.title}</h3>
      <p class="degree__institution">{degree.institution}</p>
      {degree.note && <p class="degree__note">{degree.note}</p>}
    </article>

    <div class="certs card">
      <h3 class="certs__title">Certificaciones</h3>
      <ul class="certs__list">
        {
          certifications.map((cert) => (
            <li class="certs__item">
              <div>
                <p class="certs__name">{cert.name}</p>
                <p class="certs__issuer">{cert.issuer}</p>
              </div>
              <time datetime={cert.isoDate}>{cert.date}</time>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Section>

<style>
  .education {
    display: grid;
    gap: 16px;
  }

  .degree {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: clamp(22px, 3vw, 32px);
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-contrast);
  }

  .degree__period {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    opacity: 0.85;
  }

  .degree__title {
    font-size: clamp(1.375rem, 3vw, 1.75rem);
    font-weight: 700;
  }

  .degree__institution {
    font-weight: 500;
  }

  .degree__note {
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid color-mix(in srgb, var(--accent-contrast) 30%, transparent);
    font-size: 0.875rem;
    opacity: 0.9;
  }

  .certs {
    padding: clamp(22px, 3vw, 28px);
  }

  .certs__title {
    font-size: 1.0625rem;
    font-weight: 600;
    margin-bottom: 6px;
  }

  .certs__list {
    list-style: none;
  }

  .certs__item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding-block: 12px;
  }

  .certs__item + .certs__item {
    border-top: 1px solid var(--border);
  }

  .certs__name {
    font-weight: 500;
    line-height: 1.4;
  }

  .certs__issuer {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .certs__item time {
    flex: none;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  @media (min-width: 880px) {
    .education {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 20px;
    }
  }
</style>
