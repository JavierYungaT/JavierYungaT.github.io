---
interface Props {
  /** `dark` para fondos azul marino, `light` para fondos claros. */
  tone?: 'dark' | 'light';
}

const { tone = 'dark' } = Astro.props;
---

<canvas class="neural" data-neural data-tone={tone} aria-hidden="true"></canvas>

<script>
  // Red de nodos que se mueven y se conectan; reacciona al puntero.
  // Solo anima mientras es visible y nunca con prefers-reduced-motion.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const palettes = {
    dark: { line: '22, 200, 245', lineAlpha: 0.32, pointer: '10, 108, 240', node: 'rgba(22, 200, 245, 0.9)' },
    light: { line: '10, 108, 240', lineAlpha: 0.16, pointer: '10, 108, 240', node: 'rgba(10, 108, 240, 0.45)' },
  };

  interface Node {
    x: number;
    y: number;
    vx: number;
    vy: number;
    r: number;
  }

  document.querySelectorAll<HTMLCanvasElement>('canvas[data-neural]').forEach((canvas) => {
    const ctx = canvas.getContext('2d');
    const host = canvas.parentElement;
    if (!ctx || !host) return;

    const palette = palettes[canvas.dataset.tone === 'light' ? 'light' : 'dark'];
    const pointer = { x: -9999, y: -9999 };
    let nodes: Node[] = [];
    let width = 0;
    let height = 0;
    let running = false;

    function setup(): void {
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      width = canvas.clientWidth;
      height = canvas.clientHeight;
      canvas.width = width * ratio;
      canvas.height = height * ratio;
      ctx!.setTransform(ratio, 0, 0, ratio, 0, 0);
      const count = Math.round(Math.min(80, (width * height) / 15000));
      nodes = Array.from({ length: count }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.35,
        vy: (Math.random() - 0.5) * 0.35,
        r: Math.random() * 1.6 + 0.8,
      }));
      draw();
    }

    function draw(): void {
      ctx!.clearRect(0, 0, width, height);
      for (let i = 0; i < nodes.length; i++) {
        const a = nodes[i];
        for (let j = i + 1; j < nodes.length; j++) {
          const b = nodes[j];
          const distance = Math.hypot(a.x - b.x, a.y - b.y);
          if (distance < 150) {
            ctx!.strokeStyle = `rgba(${palette.line}, ${(1 - distance / 150) * palette.lineAlpha})`;
            ctx!.lineWidth = 1;
            ctx!.beginPath();
            ctx!.moveTo(a.x, a.y);
            ctx!.lineTo(b.x, b.y);
            ctx!.stroke();
          }
        }
        const toPointer = Math.hypot(a.x - pointer.x, a.y - pointer.y);
        if (toPointer < 190) {
          ctx!.strokeStyle = `rgba(${palette.pointer}, ${(1 - toPointer / 190) * 0.7})`;
          ctx!.beginPath();
          ctx!.moveTo(a.x, a.y);
          ctx!.lineTo(pointer.x, pointer.y);
          ctx!.stroke();
        }
      }
      ctx!.fillStyle = palette.node;
      for (const node of nodes) {
        ctx!.beginPath();
        ctx!.arc(node.x, node.y, node.r, 0, Math.PI * 2);
        ctx!.fill();
      }
    }

    function tick(): void {
      if (!running) return;
      for (const node of nodes) {
        node.x += node.vx;
        node.y += node.vy;
        if (node.x < 0 || node.x > width) node.vx *= -1;
        if (node.y < 0 || node.y > height) node.vy *= -1;
      }
      draw();
      requestAnimationFrame(tick);
    }

    new IntersectionObserver(([entry]) => {
      const shouldRun = entry.isIntersecting && !reduceMotion;
      if (shouldRun && !running) {
        running = true;
        requestAnimationFrame(tick);
      } else if (!shouldRun) {
        running = false;
      }
    }).observe(canvas);

    host.addEventListener('pointermove', (event) => {
      const rect = canvas.getBoundingClientRect();
      pointer.x = event.clientX - rect.left;
      pointer.y = event.clientY - rect.top;
    });
    host.addEventListener('pointerleave', () => {
      pointer.x = -9999;
      pointer.y = -9999;
    });

    let resizeTimer: number | undefined;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(setup, 150);
    });

    setup();
  });
</script>

<style>
  .neural {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
