---
import Icon from './Icon.astro';
import Modal from './Modal.astro';
import ModalTrigger from './ModalTrigger.astro';
import Section from './Section.astro';
import { useI18n } from '@/i18n';

const { c, t } = useI18n(Astro.currentLocale);
const { sections, stack, stackExtras } = c;
const levelOrder = ['advanced', 'intermediate', 'basic'] as const;
---

<Section id="stack" heading={sections.stack} tone="dark" fx="code">
  <div class="stack" data-reveal>
    {
      stack.map((group) => (
        <section class="stack__group" aria-labelledby={`stack-${group.icon}`}>
          <span class="stack__icon">
            <Icon name={group.icon} size={30} />
          </span>
          <h3 id={`stack-${group.icon}`} class="stack__title">
            {group.title}
          </h3>
          <ul class="stack__list">
            {group.skills.map((skill) => (
              <li class="stack__item">
                <span>{skill.name}</span>
                <span class:list={['stack__level', `stack__level--${skill.level}`]}>
                  <span class="stack__meter" aria-hidden="true">
                    <i />
                    <i />
                    <i />
                  </span>
                  <span class="sr-only">{t.levels[skill.level]}</span>
                </span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
  <p class="stack__legend" aria-hidden="true">
    <span class="stack__legend-title">{t.levelLegend}</span>
    {
      levelOrder.map((level) => (
        <span class:list={['stack__level', `stack__level--${level}`]}>
          <span class="stack__meter">
            <i />
            <i />
            <i />
          </span>
          {t.levels[level]}
        </span>
      ))
    }
  </p>

  <ModalTrigger target="otros-conocimientos" icon="sparkles">{t.otherSkillsButton}</ModalTrigger>

  <Modal id="otros-conocimientos" title={t.otherSkillsTitle} intro={t.otherSkillsIntro} closeLabel={t.close}>
    <div class="extras">
    {
      stackExtras.map((group, index) => (
        <section class:list={['extras__group', { 'extras__group--wide': index === 0 }]} aria-labelledby={`extra-${group.icon}`}>
          <h3 id={`extra-${group.icon}`} class="extras__title">
            <Icon name={group.icon} size={20} />
            {group.title}
          </h3>
          {group.items.some((item) => item.detail) ? (
            <ul class="extras__details">
              {group.items.map((item) => (
                <li>
                  <strong>{item.name}</strong>
                  {item.detail && <span>{item.detail}</span>}
                </li>
              ))}
            </ul>
          ) : (
            <ul class="extras__chips">
              {group.items.map((item) => (
                <li>{item.name}</li>
              ))}
            </ul>
          )}
        </section>
      ))
    }
  </div>
  </Modal>
</Section>

<style>
  /* Tarjetas unidas, separadas por líneas finas. */
  .stack {
    display: grid;
    gap: 1px;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--border);
    box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.6);
  }

  .stack__group {
    position: relative;
    padding: clamp(24px, 3vw, 32px);
    background: var(--surface);
    color: var(--text);
    transition: background 0.4s ease;
  }

  .stack__group::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: var(--gradient);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease-out);
  }

  .stack__group:hover::before {
    transform: scaleX(1);
  }

  .stack__icon {
    display: inline-flex;
    color: var(--accent);
    transition: color 0.4s ease;
  }

  .stack__group:hover .stack__icon {
    color: var(--brand-light);
  }

  .stack__title {
    margin: 18px 0 14px;
    font-size: 1.25rem;
  }

  .stack__list {
    list-style: none;
  }

  .stack__item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding-block: 11px;
    font-size: 0.9375rem;
    border-top: 1px solid var(--border);
  }

  .stack__level {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-muted);
  }

  .stack__meter {
    display: inline-flex;
    gap: 3px;
  }

  .stack__meter i {
    width: 10px;
    height: 4px;
    border-radius: 2px;
    background: var(--border-strong);
  }

  .stack__level--basic .stack__meter i:first-child,
  .stack__level--intermediate .stack__meter i:nth-child(-n + 2),
  .stack__level--advanced .stack__meter i {
    background: var(--gradient);
  }

  .stack__legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 28px;
    margin: 28px auto 0;
    width: fit-content;
    max-width: 100%;
    padding: 10px 18px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(9, 26, 20, 0.92);
  }

  .stack__legend .stack__level {
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.7);
  }

  .stack__legend-title {
    font-size: 0.75rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }

  .stack__legend .stack__meter i {
    background: rgba(255, 255, 255, 0.2);
  }

  .stack__legend .stack__level--basic .stack__meter i:first-child,
  .stack__legend .stack__level--intermediate .stack__meter i:nth-child(-n + 2),
  .stack__legend .stack__level--advanced .stack__meter i {
    background: var(--gradient);
  }

  /* Conocimientos complementarios */
  .extras {
    display: grid;
    gap: 16px;
  }

  .extras__group {
    display: grid;
    gap: 16px;
    align-content: start;
    padding: 22px;
    border-radius: var(--radius);
    border: 1px solid rgba(255, 255, 255, 0.1);
    /* Fondo casi opaco para que la lluvia de código no se mezcle con el texto. */
    background: rgba(9, 26, 20, 0.92);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .extras__title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.0625rem;
    color: #ffffff;
  }

  .extras__title :global(.icon) {
    color: var(--brand-light);
  }

  .extras__chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .extras__chips li {
    padding: 6px 11px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .extras__details {
    list-style: none;
    display: grid;
    gap: 12px;
  }

  .extras__details li {
    display: grid;
    gap: 2px;
  }

  .extras__details strong {
    font-weight: 600;
    color: #ffffff;
  }

  .extras__details span {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.65);
  }

  @media (min-width: 760px) {
    .extras {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .extras__group--wide {
      grid-column: 1 / -1;
    }
  }


  @media (min-width: 600px) {
    .stack {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1040px) {
    .stack {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
