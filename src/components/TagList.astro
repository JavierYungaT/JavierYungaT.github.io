---
interface Props {
  tags: string[];
  label?: string;
}

const { tags, label = 'Tecnologías' } = Astro.props;
---

<ul class="tags" aria-label={label}>
  {tags.map((tag) => <li class="tag">{tag}</li>)}
</ul>

<style>
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1;
    padding: 6px 9px;
    border-radius: 6px;
    background: var(--surface-muted);
    border: 1px solid var(--border);
    color: var(--text-muted);
    white-space: nowrap;
  }
</style>
