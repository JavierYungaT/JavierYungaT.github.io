---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Button from './Button.astro';
import { hero, stats } from '@/data/profile';
import { site } from '@/data/site';

// Se resuelve en el build: si public/foto.jpg no existe, se muestra el monograma.
const hasPhoto = existsSync(join(process.cwd(), 'public', hero.photo));
---

<section id="inicio" class="hero" aria-labelledby="hero-titulo">
  <div class="container hero__grid">
    <div class="hero__content">
      <p class="hero__status">
        <span class="hero__dot" aria-hidden="true"></span>
        {hero.availability}
      </p>
      <h1 id="hero-titulo" class="hero__title">{hero.title}</h1>
      <p class="hero__subtitle">{hero.subtitle}</p>
      <div class="hero__actions">
        <Button href="#proyectos">Ver proyectos</Button>
        <Button href={hero.cv} variant="secondary" download>
          Descargar CV
        </Button>
      </div>
    </div>

    <div class="hero__portrait">
      {
        hasPhoto ? (
          <img src={hero.photo} alt={`Foto de ${site.name}`} width="480" height="480" loading="eager" />
        ) : (
          <span class="hero__monogram" aria-hidden="true">
            {hero.monogram}
          </span>
        )
      }
    </div>

    <dl class="hero__stats">
      {
        stats.map((stat) => (
          <div class="hero__stat">
            <dt>
              {stat.label}
              {stat.detail && <span class="hero__stat-detail"> ({stat.detail})</span>}
            </dt>
            <dd>{stat.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(40px, 8vw, 96px) 0;
  }

  .hero__grid {
    display: grid;
    gap: 32px;
    grid-template-areas:
      'portrait'
      'content'
      'stats';
  }

  .hero__content {
    grid-area: content;
    display: grid;
    gap: 20px;
    align-content: center;
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    justify-self: start;
    padding: 6px 14px 6px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .hero__dot {
    width: 9px;
    height: 9px;
    flex: none;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 0 4px var(--success-ring);
  }

  .hero__title {
    font-size: clamp(2.125rem, 6.4vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.05;
    max-width: 16ch;
  }

  .hero__subtitle {
    font-size: clamp(1.0625rem, 2vw, 1.1875rem);
    color: var(--text-muted);
    max-width: 58ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 4px;
  }

  .hero__portrait {
    grid-area: portrait;
    width: 96px;
    aspect-ratio: 1;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--accent-soft);
  }

  .hero__portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__monogram {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2.25rem;
    letter-spacing: -0.04em;
    color: var(--accent);
  }

  .hero__stats {
    grid-area: stats;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 8px 0 0;
    border-block: 1px solid var(--border);
  }

  .hero__stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 4px;
    padding: 20px 12px;
  }

  .hero__stat:first-child {
    padding-left: 0;
  }

  .hero__stat + .hero__stat {
    border-left: 1px solid var(--border);
  }

  .hero__stat dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .hero__stat dt {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--text-muted);
  }

  .hero__stat-detail {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  @media (min-width: 880px) {
    .hero__grid {
      grid-template-columns: 1fr 300px;
      grid-template-areas:
        'content portrait'
        'stats stats';
      column-gap: 64px;
      row-gap: 56px;
    }

    .hero__portrait {
      width: 100%;
      align-self: center;
      border-radius: 32px;
    }

    .hero__monogram {
      font-size: 6rem;
    }

    .hero__stat {
      padding: 28px 24px;
    }
  }
</style>
