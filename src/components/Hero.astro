---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BackgroundFx from './BackgroundFx.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import { hero, stats } from '@/data/profile';
import { site } from '@/data/site';
import { stack } from '@/data/stack';

// Se resuelve en el build: si la foto no existe en public/, se muestra el monograma.
const hasPhoto = existsSync(join(process.cwd(), 'public', hero.photo));
const stackNames = stack.flatMap((group) => group.skills.map((skill) => skill.name));
---

<section id="inicio" class="hero" aria-labelledby="hero-titulo">
  <div class="hero__backdrop" aria-hidden="true">
    <div class="hero__grid-lines"></div>
    <div class="hero__glow"></div>
  </div>
  <BackgroundFx effect="code" />

  <div class="container">
    <div class="bento">
      <div class="bento__card bento__main" data-reveal>
        <p class="hero__status">
          <span class="hero__ping" aria-hidden="true"><i></i></span>
          {hero.availability}
        </p>
        <h1 id="hero-titulo" class="hero__title">
          <span class="text-gradient">{hero.titleHighlight}</span>
          {hero.titleRest}
        </h1>
        <p class="hero__subtitle">{hero.subtitle}</p>
        <div class="hero__actions">
          <Button href="#proyectos" icon="arrowRight">Ver proyectos</Button>
          <Button href={hero.cv} variant="ghost" icon="download" download>Descargar CV</Button>
        </div>
      </div>

      <div class="bento__card bento__profile" data-reveal style="--d: 120ms">
        <div class="bento__photo">
          {
            hasPhoto ? (
              <img src={hero.photo} alt={`Foto de ${site.name}`} width="500" height="500" loading="eager" />
            ) : (
              <span class="bento__monogram" aria-hidden="true">
                {hero.monogram}
              </span>
            )
          }
        </div>
        <p class="bento__name">
          {site.name}
          <span>{hero.role}</span>
        </p>
      </div>

      {
        stats.map((stat, index) => (
          <div class="bento__card bento__stat" data-reveal style={`--d: ${200 + index * 80}ms`}>
            <Icon name={stat.icon} size={22} class="bento__stat-icon" />
            <p>
              <strong data-count={stat.value} data-suffix={stat.suffix ?? ''}>
                {stat.value}
                {stat.suffix}
              </strong>
              <span>
                {stat.label}
                {stat.detail && <small>{stat.detail}</small>}
              </span>
            </p>
          </div>
        ))
      }

      <div class="bento__card bento__stack" data-reveal style="--d: 440ms">
        <p class="bento__label">Stack</p>
        <ul class="sr-only">
          {stackNames.map((name) => <li>{name}</li>)}
        </ul>
        <div class="marquee" aria-hidden="true">
          <div class="marquee__track">
            {[...stackNames, ...stackNames].map((name) => <span>{name}</span>)}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    --fx-rgb: 110, 231, 183;
    --fx-alpha: 1;
    position: relative;
    padding: calc(var(--header-h) + clamp(24px, 5vw, 56px)) 0 clamp(88px, 10vw, 128px);
    color: #ffffff;
    isolation: isolate;
  }

  .hero__backdrop,
  .hero > :global(.fx) {
    position: absolute;
    inset: 0;
    height: auto;
    z-index: -1;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 56px), 0 100%);
  }

  /* La lluvia de código se atenúa a la izquierda, donde va el titular. */
  .hero > :global(.fx) {
    -webkit-mask-image: linear-gradient(90deg, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.35) 45%, #000 80%);
    mask-image: linear-gradient(90deg, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.35) 45%, #000 80%);
  }

  .hero__backdrop {
    overflow: hidden;
    background: var(--gradient-ink);
  }

  .hero__grid-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(to bottom, #000 40%, transparent);
  }

  .hero__glow {
    position: absolute;
    right: -10%;
    top: 0;
    width: 60%;
    height: 80%;
    background: radial-gradient(closest-side, rgba(16, 185, 129, 0.28), transparent);
  }

  /* ---------- Bento ---------- */
  .bento {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .bento__card {
    position: relative;
    min-width: 0;
    padding: 18px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    background: rgba(255, 255, 255, 0.035);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    transition:
      border-color 0.4s ease,
      background-color 0.4s ease;
  }

  .bento__card:hover {
    border-color: rgba(110, 231, 183, 0.3);
    background: rgba(255, 255, 255, 0.05);
  }

  .bento__main,
  .bento__profile,
  .bento__stack {
    grid-column: 1 / -1;
  }

  /* Presentación */
  .bento__main {
    display: grid;
    gap: 20px;
    justify-items: start;
    padding: clamp(22px, 4vw, 44px);
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 8px 16px 8px 12px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.05);
    font-size: 0.875rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.9);
  }

  .hero__ping {
    position: relative;
    display: inline-flex;
    width: 9px;
    height: 9px;
    flex: none;
    border-radius: 50%;
    background: var(--success);
  }

  .hero__ping i {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--success);
    animation: ping 1.6s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  .hero__title {
    font-size: clamp(2.125rem, 6vw, 3.75rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
    max-width: 16ch;
  }

  .hero__title .text-gradient {
    display: block;
  }

  .hero__subtitle {
    max-width: 58ch;
    font-size: clamp(1rem, 1.6vw, 1.125rem);
    color: rgba(255, 255, 255, 0.72);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 4px;
  }

  /* Perfil: foto + nombre (en móvil, en fila) */
  .bento__profile {
    display: flex;
    align-items: center;
    gap: 18px;
    background: linear-gradient(160deg, rgba(16, 185, 129, 0.16), rgba(255, 255, 255, 0.02));
  }

  .bento__photo {
    flex: none;
    width: 88px;
    aspect-ratio: 1;
    padding: 4px;
    border-radius: 50%;
    background: var(--gradient);
    box-shadow: 0 20px 48px -18px rgba(16, 185, 129, 0.8);
  }

  .bento__photo img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .bento__monogram {
    display: grid;
    place-items: center;
    height: 100%;
    border-radius: 50%;
    background: var(--ink-900);
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
  }

  .bento__name {
    display: grid;
    gap: 2px;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .bento__name span {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.65);
  }

  /* Cifras */
  .bento__stat {
    display: grid;
    gap: 10px;
    align-content: space-between;
    padding: 14px;
  }

  @media (max-width: 400px) {
    .bento__stat span {
      font-size: 0.75rem;
    }
  }

  .bento__stat :global(.bento__stat-icon) {
    color: var(--brand-light);
  }

  .bento__stat p {
    display: grid;
    gap: 4px;
  }

  .bento__stat strong {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .bento__stat span {
    font-size: 0.8125rem;
    line-height: 1.35;
    color: rgba(255, 255, 255, 0.65);
  }

  .bento__stat small {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  /* Stack en carrusel */
  .bento__stack {
    display: grid;
    gap: 12px;
    align-content: center;
    overflow: hidden;
  }

  .bento__label {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }

  .marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .marquee__track {
    display: flex;
    gap: 8px;
    width: max-content;
    animation: marquee 40s linear infinite;
  }

  .bento__stack:hover .marquee__track {
    animation-play-state: paused;
  }

  .marquee__track span {
    padding: 6px 11px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.82);
    white-space: nowrap;
  }

  @keyframes marquee {
    to {
      transform: translateX(calc(-50% - 4px));
    }
  }

  @media (min-width: 1024px) {
    .bento {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 16px;
    }

    .bento__main {
      grid-column: span 4;
      grid-row: span 2;
    }

    .bento__profile {
      grid-column: span 2;
      grid-row: span 2;
      flex-direction: column;
      justify-content: center;
      text-align: center;
      gap: 20px;
    }

    .bento__photo {
      width: min(78%, 240px);
    }

    .bento__stat {
      grid-column: span 1;
      padding: 22px;
    }

    .bento__stack {
      grid-column: span 3;
      padding: 22px;
    }
  }
</style>
