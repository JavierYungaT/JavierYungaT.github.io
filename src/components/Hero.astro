---
import Button from './Button.astro';
import CodeWindow from './CodeWindow.astro';
import Icon from './Icon.astro';
import NeuralCanvas from './NeuralCanvas.astro';
import { hero, stats } from '@/data/profile';

// Código decorativo de la ventana del hero (k: palabra clave, s: texto, f: función, n: valor, c: comentario).
const codeSample = [
  `<span class="k">import</span> { Ingeniero } <span class="k">from</span> <span class="s">'javier-yunga'</span>;`,
  ``,
  `<span class="k">const</span> javier = <span class="k">new</span> <span class="f">Ingeniero</span>({`,
  `  experiencia: <span class="s">'4+ años'</span>,`,
  `  enfoque: [<span class="s">'web'</span>, <span class="s">'móvil'</span>, <span class="s">'backend'</span>],`,
  `  stack: [<span class="s">'Spring Boot'</span>, <span class="s">'NestJS'</span>, <span class="s">'Django'</span>],`,
  `  disponible: <span class="n">true</span>,`,
  `});`,
  ``,
  `javier.<span class="f">construir</span>(); <span class="c">// software que se usa a diario</span>`,
].join('\n');
---

<section id="inicio" class="hero" aria-labelledby="hero-titulo">
  <div class="hero__backdrop" aria-hidden="true">
    <div class="hero__grid-lines"></div>
    <div class="hero__glow"></div>
  </div>
  <NeuralCanvas tone="dark" />

  <div class="container hero__inner">
    <div class="hero__content" data-reveal>
      <p class="hero__status">
        <span class="hero__ping" aria-hidden="true"><i></i></span>
        {hero.availability}
      </p>
      <h1 id="hero-titulo" class="hero__title">
        <span class="text-gradient">{hero.titleHighlight}</span>
        {hero.titleRest}
      </h1>
      <p class="hero__subtitle">{hero.subtitle}</p>
      <div class="hero__actions">
        <Button href="#proyectos" icon="arrowRight">Ver proyectos</Button>
        <Button href={hero.cv} variant="ghost" icon="download" download>Descargar CV</Button>
      </div>
    </div>

    <div class="hero__visual" aria-hidden="true" data-reveal style="--d: 200ms">
      <div class="hero__float">
        <CodeWindow filename="javier.ts" typewriter><Fragment set:html={codeSample} /></CodeWindow>
        <div class="hero__badge hero__badge--top">
          <Icon name="branch" size={22} />
          <span>
            <small>main</small>
            Listo para producción
          </span>
        </div>
        <div class="hero__badge hero__badge--bottom">
          <Icon name="code" size={24} />
          <span>
            <strong>Full stack</strong>
            <small>web · móvil · cloud</small>
          </span>
        </div>
      </div>
    </div>
  </div>

  <div class="container hero__stats-wrap">
    <dl class="hero__stats card">
      {
        stats.map((stat, index) => (
          <div class="hero__stat" data-reveal style={`--d: ${index * 120}ms`}>
            <Icon name={stat.icon} size={30} class="hero__stat-icon" />
            <dt>
              {stat.label}
              {stat.detail && <span class="hero__stat-detail">{stat.detail}</span>}
            </dt>
            <dd data-count={stat.value} data-suffix={stat.suffix ?? ''}>
              {stat.value}
              {stat.suffix}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    --overlap: 96px;
    position: relative;
    padding-top: calc(var(--header-h) + clamp(40px, 8vw, 96px));
    color: #ffffff;
    isolation: isolate;
  }

  /* El fondo oscuro termina antes de la tarjeta de cifras para que esta "flote". */
  .hero__backdrop,
  .hero > :global(.neural) {
    position: absolute;
    inset: 0 0 var(--overlap);
    height: auto;
    z-index: -1;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 calc(100% - 48px));
  }

  .hero__backdrop {
    overflow: hidden;
    background: var(--gradient-navy);
  }

  .hero__grid-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(to bottom, #000 40%, transparent);
  }

  .hero__glow {
    position: absolute;
    right: -10%;
    top: 10%;
    width: 60%;
    height: 70%;
    background: radial-gradient(closest-side, rgba(10, 108, 240, 0.35), transparent);
  }

  .hero__inner {
    display: grid;
    gap: 56px;
    align-items: center;
    padding-bottom: calc(var(--overlap) + 72px);
  }

  .hero__content {
    display: grid;
    gap: 24px;
    justify-items: start;
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 8px 16px 8px 12px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.05);
    font-size: 0.875rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.9);
  }

  .hero__ping {
    position: relative;
    display: inline-flex;
    width: 9px;
    height: 9px;
    flex: none;
    border-radius: 50%;
    background: var(--success);
  }

  .hero__ping i {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--success);
    animation: ping 1.6s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  .hero__title {
    font-size: clamp(2.375rem, 7vw, 4rem);
    line-height: 1.06;
    letter-spacing: -0.035em;
    max-width: 14ch;
  }

  .hero__title .text-gradient {
    display: block;
  }

  .hero__subtitle {
    max-width: 54ch;
    font-size: clamp(1.0625rem, 2vw, 1.1875rem);
    color: rgba(255, 255, 255, 0.74);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 8px;
  }

  .hero__visual {
    display: none;
  }

  .hero__float {
    position: relative;
    animation: float 7s ease-in-out infinite;
  }

  .hero__badge {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 18px;
    border-radius: 8px;
    font-size: 0.875rem;
    line-height: 1.3;
  }

  .hero__badge span {
    display: grid;
  }

  .hero__badge small {
    font-size: 0.75rem;
    opacity: 0.7;
  }

  .hero__badge strong {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
  }

  .hero__badge--top {
    top: -26px;
    right: -18px;
    background: rgba(5, 13, 31, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--cyan);
  }

  .hero__badge--top span {
    color: #ffffff;
  }

  .hero__badge--bottom {
    bottom: -30px;
    left: -30px;
    background: var(--gradient);
    box-shadow: var(--shadow-glow);
  }

  /* Cifras */
  .hero__stats-wrap {
    margin-top: calc(var(--overlap) * -1);
  }

  .hero__stats {
    display: grid;
    margin: 0;
    color: var(--text);
    box-shadow: var(--shadow);
  }

  .hero__stat {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      'icon value'
      'icon label';
    column-gap: 18px;
    align-items: center;
    padding: 24px;
  }

  .hero__stat + .hero__stat {
    border-top: 1px solid var(--border);
  }

  .hero__stat :global(.hero__stat-icon) {
    grid-area: icon;
    color: var(--blue);
  }

  .hero__stat dd {
    grid-area: value;
    margin: 0;
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .hero__stat dt {
    grid-area: label;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  .hero__stat-detail {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  @media (min-width: 720px) {
    .hero__stats {
      grid-template-columns: repeat(3, 1fr);
    }

    .hero__stat {
      grid-template-columns: 1fr;
      grid-template-areas:
        'icon'
        'value'
        'label';
      row-gap: 12px;
      padding: 32px;
    }

    .hero__stat + .hero__stat {
      border-top: 0;
      border-left: 1px solid var(--border);
    }
  }

  @media (min-width: 1024px) {
    .hero__backdrop,
    .hero > :global(.neural) {
      clip-path: polygon(6% 0, 100% 0, 100% 45%, 96% 100%, 0 100%, 0 68%);
    }

    .hero__inner {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 64px;
    }

    .hero__visual {
      display: block;
      padding: 0 24px 0 16px;
    }
  }
</style>
