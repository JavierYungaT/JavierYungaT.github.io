---
import Button from './Button.astro';
import Icon from './Icon.astro';
import Section from './Section.astro';
import { contact, sections, socialLinks } from '@/data/site';
---

<Section id="contacto" heading={sections.contact} tone="soft" neural>
  <p slot="intro">{contact.text}</p>
  <div class="contact card" data-reveal>
    <div class="contact__actions">
      <Button href={`mailto:${contact.email}`} icon="mail">Escríbeme</Button>
      {
        socialLinks.map((link) => (
          <Button href={link.href} variant="outline" icon="arrowUpRight" external>
            {link.label}
          </Button>
        ))
      }
    </div>
    <p class="contact__email">
      <Icon name="mail" size={16} />
      <a href={`mailto:${contact.email}`}>{contact.email}</a>
    </p>
  </div>
</Section>

<style>
  .contact {
    display: grid;
    justify-items: center;
    gap: 24px;
    max-width: 720px;
    margin-inline: auto;
    padding: clamp(28px, 5vw, 48px) clamp(20px, 5vw, 48px);
    box-shadow: var(--shadow);
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
  }

  .contact__email {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }

  .contact__email a {
    color: inherit;
    text-decoration: none;
  }

  .contact__email a:hover {
    color: var(--blue);
  }
</style>
