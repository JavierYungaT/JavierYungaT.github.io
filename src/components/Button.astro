---
import Icon from './Icon.astro';
import type { IconName } from '@/lib/icons';

interface Props {
  href: string;
  /**
   * primary: degradado de marca.
   * ghost: borde claro, para fondos oscuros.
   * outline: borde oscuro, para fondos claros.
   */
  variant?: 'primary' | 'ghost' | 'outline';
  icon?: IconName;
  /** Abre en otra pestaña con rel seguro. */
  external?: boolean;
  /** true descarga con el nombre original; un texto define el nombre del archivo descargado. */
  download?: boolean | string;
}

const { href, variant = 'primary', icon, external = false, download = false } = Astro.props;
---

<a
  href={href}
  class:list={['button', `button--${variant}`]}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  download={download === true ? '' : download || undefined}
>
  <span><slot /></span>
  {icon && <Icon name={icon} size={18} class="button__icon" />}
</a>

<style>
  .button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 48px;
    padding: 12px 24px;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1.2;
    text-transform: uppercase;
    text-decoration: none;
    isolation: isolate;
    transition:
      transform 0.3s var(--ease-out),
      box-shadow 0.3s var(--ease-out),
      background-color 0.3s ease,
      border-color 0.3s ease,
      color 0.3s ease;
  }

  .button :global(.button__icon) {
    transition: transform 0.3s var(--ease-out);
  }

  .button:hover :global(.button__icon) {
    transform: translateX(3px);
  }

  .button--primary {
    background: var(--gradient);
    color: #ffffff;
  }

  .button--primary:hover {
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: var(--shadow-glow);
  }

  .button--ghost {
    border-color: rgba(255, 255, 255, 0.45);
    color: #ffffff;
  }

  .button--ghost:hover {
    color: #ffffff;
    border-color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
  }

  .button--outline {
    border-color: var(--text);
    color: var(--text);
  }

  .button--outline:hover {
    background: var(--text);
    color: var(--bg);
  }
</style>
