---
import ProjectCard from './ProjectCard.astro';
import Section from './Section.astro';
import { projects, projectsNote } from '@/data/projects';
import { sections } from '@/data/site';
---

<Section id="proyectos" heading={sections.projects}>
  <p slot="intro">{projectsNote}</p>
  <ul class="projects">
    {
      projects.map((project, index) => (
        <li class:list={{ 'projects__item--wide': project.featured }} data-reveal style={`--d: ${(index % 2) * 120}ms`}>
          <ProjectCard project={project} />
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .projects {
    list-style: none;
    display: grid;
    gap: 20px;
  }

  .projects > li {
    min-width: 0;
  }

  @media (min-width: 760px) {
    .projects {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }

    .projects__item--wide,
    .projects > li:last-child:nth-child(even) {
      grid-column: 1 / -1;
    }
  }
</style>
